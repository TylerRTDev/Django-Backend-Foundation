{
  "title": "Container Resource Overview",
  "description": "Container-level CPU, memory, network, and disk metrics during benchmark runs",
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {},
  "tags": ["monitoring", "docker", "benchmark"],
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage (by container)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "custom": {
            "displayMode": "table",
            "stacking": { "mode": "normal" },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[30s])) by (name)",
          "legendFormat": "{{ name }}",
          "interval": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage (by container)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "custom": {
            "stacking": { "mode": "normal" },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name!=\"\"}",
          "legendFormat": "{{ name }}",
          "interval": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Network Receive (by container)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "custom": {
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name!=\"\"}[30s])",
          "legendFormat": "{{ name }}",
          "interval": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Network Transmit (by container)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "custom": {
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "rate(container_network_transmit_bytes_total{name!=\"\"}[30s])",
          "legendFormat": "{{ name }}",
          "interval": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Filesystem Usage (by container)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "custom": {
            "displayMode": "table"
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": []
      },
      "targets": [
        {
          "expr": "container_fs_usage_bytes{name!=\"\"}",
          "legendFormat": "{{ name }}",
          "interval": "",
          "refId": "A"
        }
      ]
    }
  ]
}