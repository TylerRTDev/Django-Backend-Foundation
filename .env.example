# Django settings for development environment
DJANGO_SECRET_KEY=your-very-secret-development-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG_DEV=True
DJANGO_SETTINGS_MODULE=config.settings.dev # Pointing to the development settings module, switch to config.settings.prod for production

# Database configuration
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_STATIC_BUCKET_NAME=yourstaticbucket
MINIO_MEDIA_BUCKET_NAME=yourmediabucket # The media bucket name (optional)
MINIO_PRIVATE_MEDIA_BUCKET_NAME=yourprivatemediabucket # The private media bucket name (optional)
MINIO_BUCKET_NAME=${MINIO_STATIC_BUCKET_NAME}
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_PUBLIC_DOMAIN=localhost:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER} # The MINIO_ROOT_USER variable is deprecated, use AWS_ACCESS_KEY_ID
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD} # The MINIO_ROOT_PASSWORD is deprecated, use AWS_SECRET_ACCESS_KEY

# AWS S3 settings for MinIO
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_STORAGE_BUCKET_NAME=${MINIO_BUCKET_NAME}
AWS_S3_URL_PROTOCOL=http:
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False
AWS_QUERYSTRING_AUTH=True
AWS_S3_REGION_NAME=eu-west-1
USE_S3=False